# Browser-safe Supabase values.
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe MapTiler values.
# The deployed style URL includes a protected key as its `key` query parameter.
# Use a separate key per environment and restrict it to approved Hundavaent origins.
PUBLIC_MAPTILER_KEY=
PUBLIC_MAP_STYLE_URL=

# Public application URL for authentication redirects.
PUBLIC_APP_URL=http://127.0.0.1:5173

# Browser-safe anonymous analytics configuration.
# Leave the token empty to disable analytics in local or isolated environments.
PUBLIC_POSTHOG_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Build-only PostHog credentials for uploading browser source maps.
# The personal API key requires only Error Tracking write access and must never use a PUBLIC_ prefix.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.i.posthog.com

# Non-secret deployment context included in redacted operational telemetry.
APP_ENVIRONMENT=local
APP_RELEASE=local-dev

# Server-side authentication feature switches.
# Enable both only after Facebook, SMTP, verified-email identity linking, and the token-hash email template are configured.
AUTH_FACEBOOK_ENABLED=false
AUTH_EMAIL_ENABLED=false
# This secret must match the value installed with configure_member_activation_capability in the same environment.
MEMBER_ACTIVATION_SECRET=

# Shared password wall for provisional deployments.
# Leave empty locally; when set, every route except /gate and /api/health requires the password.
SITE_GATE_PASSWORD=

# Local evaluation controls.
EVALUATION_ENABLED=false
EVALUATION_MODERATOR_EMAIL=moderator@example.invalid

# Test-harness and deployment secrets.
# These values must never be imported by browser code or normal SvelteKit request handlers.
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=hundavaent
CLOUDFLARE_PREVIEW_BRANCH=preview
CLOUDFLARE_PREVIEW_URL=https://preview.hundavaent.pages.dev
