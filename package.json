{
  "name": "hundavaent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings 0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:component": "vitest run --config vitest.browser.config.ts",
    "test:component:watch": "vitest --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:map-smoke": "vitest run --config vitest.browser.config.ts tests/component/map-contract.browser.test.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:database": "supabase test db",
    "eval:release": "node --experimental-strip-types scripts/evaluate-release.ts",
    "open-source:check": "node --experimental-strip-types scripts/check-open-source-readiness.ts",
    "tailwind:check": "node --experimental-strip-types scripts/check-tailwind-residual-styles.ts",
    "translations:sync-from-production": "node --experimental-strip-types scripts/sync-published-interface-translations.ts",
    "ingest:launch-leads": "node --experimental-strip-types scripts/ingest-launch-leads.ts",
    "audit:launch-geometry": "node --experimental-strip-types scripts/geocode-launch-leads.ts --audit",
    "geocode:launch-inventory": "node --experimental-strip-types scripts/geocode-launch-leads.ts",
    "verify:launch-inventory": "node --experimental-strip-types scripts/verify-launch-inventory-ingestion.ts",
    "acquire:place-photos": "node --experimental-strip-types scripts/acquire-place-photos.ts",
    "audit:place-photos": "node --experimental-strip-types scripts/audit-place-photo-acquisition.ts",
    "report:member-retention": "node --experimental-strip-types scripts/report-member-retention.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/server/db/generated.types.ts && node --experimental-strip-types scripts/normalize-generated-db-types.ts && prettier --write src/lib/server/db/generated.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@hundavaent/design-system": "workspace:*",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.1",
    "maplibre-gl": "5.24.0",
    "posthog-js": "1.399.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.61.1",
    "@posthog/rollup-plugin": "1.4.7",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.6.0",
    "eslint-plugin-svelte": "3.20.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "supabase": "2.109.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "wrangler": "4.107.1"
  }
}
